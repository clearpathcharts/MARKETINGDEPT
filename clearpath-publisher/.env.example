# ClearPath Publisher — copy this file to .env and fill in what you have.
# Every channel you leave blank simply shows "needs credentials" in the console.

# ── Telegram (5 minutes) ─────────────────────────────────────────────
# 1. In Telegram, message @BotFather → /newbot → copy the token
# 2. Add the bot as an admin of your channel (@clearpathtraderfreeaccount)
# 3. Chat id = @your_channel_name (with the @) or the numeric id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@clearpathtraderfreeaccount

# ── Discord (2 minutes) ──────────────────────────────────────────────
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ── Reddit (10 minutes) ──────────────────────────────────────────────
# 1. Log in → https://www.reddit.com/prefs/apps → create app → type "script"
# 2. Client id = string under the app name; secret = "secret" field
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=ClearMarketScience

# ── YouTube (30–60 minutes, one time) ───────────────────────────────
# 1. console.cloud.google.com → new project → enable "YouTube Data API v3"
# 2. OAuth consent screen (External, add yourself as test user)
# 3. Credentials → OAuth client ID → Desktop app → copy id + secret
# 4. Get a refresh token once via OAuth playground or ask Cursor to walk you through it
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Uploads default to unlisted so you can review first. Set to "public" when ready.
YOUTUBE_PRIVACY=unlisted

# Server port (console expects 8787)
PORT=8787
